# Copy this file to .env and fill in your values
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Choose model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Temperature for the LLM (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.0

# Optional: Vector store persistence directory
VECTORSTORE_DIR=./vectorstore
